+    # False routes speed through VCruiseHelper._update_v_cruise_non_pcm instead, which actually
+    # implements button-driven speed increments and a real floor (V_CRUISE_INITIAL = 40 kph).
+    # See av-sim/README.md, "Driving the car".
+    ret.pcmCruise = False
